                 logger.info("Regex extraction failed, skipping", exc_info=True)
 
+    # ------------------------------------------------------------------
+    # Explicit release (mnemosyne#1163)
+    # ------------------------------------------------------------------
+    def close(self) -> None:
+        """Close this instance's SQLite handle and drop its thread-local cache.
+
+        Integrators (including the Hermes provider's two shutdown paths)
+        already called ``close()`` on this class; core never implemented it, so
+        the AttributeError was swallowed and the thread-local handle stayed
+        open for the process lifetime (mnemosyne#1163).
+
+        Idempotent -- later calls are no-ops -- and callable from any thread:
+        connections are opened with ``check_same_thread=False``, so closing
+        the handle from a thread other than its creator is legal. Never
+        raises: every failure path logs at debug level and continues, because
+        cleanup must not turn a healthy shutdown into an error report.
+        The caller asserts this instance (and anything sharing its handle) is
+        retired: like close_thread_connection (mnemosyne#1228), only the owner
+        may release the handle, because instances on one thread share the
+        per-path connection. ``self.conn`` keeps pointing at the CLOSED
+        connection afterwards -- the established retired-instance contract
+        (``beam.conn.close()`` then sqlite3.ProgrammingError on next use);
+        a closed connection holds no descriptor.
+        """
+        if getattr(self, "_closed", False):
+            return
+        # Flip the latch first so a failure below cannot make this re-entrant.
+        self._closed = True
+
+        # 1. Flush pending writes defensively. Harmless with no open
+        #    transaction; keeps WAL tidy on close.
+        try:
+            conn = getattr(self, "conn", None)
+            if conn is not None:
+                conn.commit()
+        except Exception:
+            logger.debug("BeamMemory.close: commit on close failed", exc_info=True)
+
+        # 2. Keep ``self.conn`` pointing at the CLOSED connection. The
+        #    established idiom for a retired instance (189 call sites across
+        #    the core and Hermes suites) is ``beam.conn.close()`` followed by
+        #    expecting sqlite3.ProgrammingError on the next use -- the same
+        #    documented contract as close_thread_connection (mnemosyne#1228).
+        #    A closed sqlite3.Connection holds no descriptor and close() is a
+        #    no-op on it, so leaving the reference is what makes close()
+        #    transparently composable with that idiom. `__init__` can fail
+        #    before `self.conn` is assigned, so tolerate its absence.
+        conn = getattr(self, "conn", None)
+
+        # 3. Close the handle. Legal from any thread because connections are
+        #    created with check_same_thread=False (mnemosyne#1163).
+        if conn is not None:
+            try:
+                conn.close()
+            except Exception:
+                logger.debug("BeamMemory.close: closing handle failed", exc_info=True)
+
+        # 4. Clear the thread-local slots that point AT THIS handle -- never
+        #    another path's. Look the caches up in sys.modules exactly like
+        #    connection_release._cached_connection_caches() does: importing
+        #    mnemosyne.core.memory here would run its import-time init_db(),
+        #    which opens a connection and republishes it into beam's cache,
+        #    displacing the handle we are trying to release.
+        if conn is not None:
+            import sys
+
+            for module_name in ("mnemosyne.core.beam", "mnemosyne.core.memory"):
+                module = sys.modules.get(module_name)
+                if module is None:
+                    continue
+                tls = getattr(module, "_thread_local", None)
+                if tls is None:
+                    continue
+                if getattr(tls, "conn", None) is conn:
+                    tls.conn = None
+                    tls.db_path = None
+
