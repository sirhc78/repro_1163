diff --git a/tests/test_core_close.py b/tests/test_core_close.py
new file mode 100644
index 0000000..1738c69
--- /dev/null
+++ b/tests/test_core_close.py
@@ -0,0 +1,291 @@
+"""Explicit close() for Mnemosyne and BeamMemory (mnemosyne#1163).
+
+Integrators -- including the Hermes provider's two shutdown paths -- already
+called ``close()`` on these classes; core never implemented it, so the
+AttributeError was swallowed and the thread-local SQLite handles stayed open
+for the process lifetime. These tests pin the release contract: idempotent,
+callable from any thread, scoped to this instance's handle only, and followed
+by a transparent reconnect on later use.
+"""
+
+import importlib
+import os
+from pathlib import Path
+import queue
+import sqlite3
+import threading
+
+import pytest
+
+from mnemosyne.core.beam import BeamMemory
+
+
+def _database_fd_count(db_path: Path) -> int:
+    """Count descriptors held for one SQLite database and its sidecars."""
+    fd_dir = Path("/proc/self/fd")
+    if not fd_dir.exists():
+        pytest.skip("open-descriptor assertions require /proc")
+
+    prefix = str(db_path)
+    count = 0
+    for fd_path in fd_dir.iterdir():
+        try:
+            target = os.readlink(fd_path)
+        except OSError:
+            continue
+        if target == prefix or target.startswith(f"{prefix}-"):
+            count += 1
+    return count
+
+
+def _directory_database_fd_count(directory: Path) -> int:
+    """Count descriptors held for SQLite files under one directory."""
+    fd_dir = Path("/proc/self/fd")
+    if not fd_dir.exists():
+        pytest.skip("open-descriptor assertions require /proc")
+
+    prefix = f"{directory}{os.sep}"
+    count = 0
+    for fd_path in fd_dir.iterdir():
+        try:
+            target = os.readlink(fd_path)
+        except OSError:
+            continue
+        if target.startswith(prefix):
+            count += 1
+    return count
+
+
+def _run_in_worker(target):
+    """Run ``target`` on a fresh thread and surface failures via queue."""
+    observed = queue.Queue()
+
+    def runner():
+        try:
+            observed.put(("ok", target()))
+        except BaseException as exc:  # pragma: no cover - surfaced by the assertion
+            observed.put(("error", exc))
+
+    worker = threading.Thread(target=runner)
+    worker.start()
+    worker.join()
+    status, payload = observed.get_nowait()
+    assert status == "ok", payload
+    return payload
+
+
+def test_close_releases_database_fds_on_live_thread(tmp_path):
+    """close() releases the handle without waiting for collection (#1163)."""
+    if not Path("/proc/self/fd").exists():
+        pytest.skip("open-descriptor assertions require /proc")
+
+    db_path = tmp_path / "close-fd.db"
+    observed = queue.Queue()
+
+    def build_close_and_count():
+        beam = BeamMemory(session_id="close-fd", db_path=db_path)
+        before = _database_fd_count(db_path)
+        beam.close()
+        observed.put((before, _database_fd_count(db_path)))
+
+    worker = threading.Thread(target=build_close_and_count)
+    worker.start()
+    worker.join()
+    before, after = observed.get_nowait()
+
+    assert before >= 1
+    assert after == 0
+
+
+def test_close_is_idempotent(tmp_path):
+    """A second close() is a no-op, never a raise (#1163)."""
+    observed = queue.Queue()
+
+    def close_twice():
+        beam = BeamMemory(session_id="idempotent", db_path=tmp_path / "idempotent.db")
+        first = beam.close()
+        second = beam.close()
+        # The retired-instance contract keeps self.conn pointing at the
+        # CLOSED connection (mnemosyne#1228 idiom): a closed sqlite3
+        # connection holds no descriptor and its close() is a no-op.
+        observed.put((first, second, beam.conn))
+
+    worker = threading.Thread(target=close_twice)
+    worker.start()
+    worker.join()
+    first, second, conn = observed.get_nowait()
+
+    assert first is None
+    assert second is None
+    assert conn is not None
+    with pytest.raises(sqlite3.ProgrammingError):
+        conn.execute("SELECT 1")
+
+
+def test_close_then_remember_raises_documented_error(tmp_path):
+    """A closed instance fails loudly on the next use, not silently (#1163).
+
+    ``self.conn`` keeps pointing at the CLOSED connection, so the next
+    ``remember()`` reaches sqlite3's "Cannot operate on a closed database"
+    ``ProgrammingError`` -- the documented retired-instance failure shared
+    with ``close_thread_connection`` (mnemosyne#1228). It never silently
+    succeeds.
+    """
+    observed = queue.Queue()
+
+    def close_then_remember():
+        beam = BeamMemory(session_id="closed-use", db_path=tmp_path / "closed-use.db")
+        beam.close()
+        try:
+            beam.remember("x")
+        except sqlite3.ProgrammingError as exc:
+            observed.put(("sqlite3.ProgrammingError", str(exc)))
+        except AttributeError as exc:  # pragma: no cover - surfaced by the assertion
+            observed.put(("AttributeError", str(exc)))
+        except BaseException as exc:  # pragma: no cover - surfaced by the assertion
+            observed.put((type(exc).__name__, repr(exc)))
+        else:  # pragma: no cover - surfaced by the assertion
+            observed.put(("no-raise", ""))
+
+    worker = threading.Thread(target=close_then_remember)
+    worker.start()
+    worker.join()
+    kind, detail = observed.get_nowait()
+
+    assert kind == "sqlite3.ProgrammingError", (kind, detail)
+
+
+def test_close_leaves_other_paths_cached(tmp_path):
+    """Closing one database must not displace another database's handle."""
+    path_a = tmp_path / "alpha.db"
+    path_b = tmp_path / "beta.db"
+    observed = queue.Queue()
+
+    def close_one_keep_other():
+        beam_a = BeamMemory(session_id="alpha", db_path=path_a)
+        beam_b = BeamMemory(session_id="beta", db_path=path_b)
+        beam_a.close()
+        kept_before = _database_fd_count(path_b)
+        value = beam_b.conn.execute("SELECT 1").fetchone()[0]
+        observed.put(
+            (
+                _database_fd_count(path_a),
+                kept_before,
+                value,
+                _database_fd_count(path_b),
+            )
+        )
+
+    worker = threading.Thread(target=close_one_keep_other)
+    worker.start()
+    worker.join()
+    path_a_fds, kept_before, value, kept_after = observed.get_nowait()
+
+    assert path_a_fds == 0
+    assert kept_before >= 1
+    assert value == 1
+    assert kept_after == kept_before
+
+
+def test_close_does_not_clear_tls_pointing_at_a_different_conn(tmp_path):
+    """close() clears only the TLS entry holding THIS handle, by identity."""
+    path_a = tmp_path / "tls-alpha.db"
+    path_b = tmp_path / "tls-beta.db"
+    observed = queue.Queue()
+
+    def displace_then_close():
+        beam_a = BeamMemory(session_id="tls-alpha", db_path=path_a)
+        conn_a = beam_a.conn
+        # beam_b's init republishes the thread-local for path B, displacing
+        # path A's cache entry while beam_a still owns conn_a.
+        beam_b = BeamMemory(session_id="tls-beta", db_path=path_b)
+        beam_b.close()
+        beam_module = importlib.import_module("mnemosyne.core.beam")
+        tls_cleared = getattr(beam_module._thread_local, "conn", None) is None
+        try:
+            usable = conn_a.execute("SELECT 1").fetchone()[0]
+        except Exception:  # pragma: no cover - surfaced by the assertion
+            usable = None
+        observed.put((tls_cleared, usable, _database_fd_count(path_a)))
+
+    worker = threading.Thread(target=displace_then_close)
+    worker.start()
+    worker.join()
+    tls_cleared, usable, path_a_fds = observed.get_nowait()
+
+    assert tls_cleared is True
+    assert usable == 1
+    # conn_a is still open: its database, -wal and -shm descriptors remain
+    # (plus init's schema probe), so at least one descriptor survives while
+    # path B's are all gone.
+    assert path_a_fds >= 1
+
+
+def test_mnemosyne_close_releases_beam_and_thread_handle(tmp_path):
+    """Mnemosyne.close() releases its beam and this thread's cached handle."""
+    if not Path("/proc/self/fd").exists():
+        pytest.skip("open-descriptor assertions require /proc")
+
+    observed = queue.Queue()
+
+    def build_and_close():
+        from mnemosyne.core.memory import Mnemosyne
+
+        memory = Mnemosyne(db_path=tmp_path / "mnemo.db")
+        before = _directory_database_fd_count(tmp_path)
+        memory.close()
+        second = memory.close()
+        observed.put((before, _directory_database_fd_count(tmp_path), second))
+
+    worker = threading.Thread(target=build_and_close)
+    worker.start()
+    worker.join()
+    before, after, second = observed.get_nowait()
+
+    assert before >= 1
+    assert after == 0
+    assert second is None
+
+
+def test_mnemosyne_close_on_main_thread_releases(tmp_path):
+    """close() works on the main thread, where provider shutdown runs (#1228)."""
+    if not Path("/proc/self/fd").exists():
+        pytest.skip("open-descriptor assertions require /proc")
+
+    from mnemosyne.core.memory import Mnemosyne
+
+    memory = Mnemosyne(db_path=tmp_path / "main-thread.db")
+    before = _directory_database_fd_count(tmp_path)
