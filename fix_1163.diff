+def test_close_is_safe_from_a_different_thread(tmp_path):
+    """Closing from another thread is legal: check_same_thread=False (#1163)."""
+    if not Path("/proc/self/fd").exists():
+        pytest.skip("open-descriptor assertions require /proc")
+
+    db_path = tmp_path / "cross-thread.db"
+    handoff = queue.Queue()
+    observed = queue.Queue()
+
+    def create_and_hand_off():
+        beam = BeamMemory(session_id="cross-thread", db_path=db_path)
+        handoff.put(beam)
+
+    creator = threading.Thread(target=create_and_hand_off)
+    creator.start()
+    creator.join()
+    beam = handoff.get_nowait()
+
+    def close_from_elsewhere():
+        beam.close()
+        observed.put(_database_fd_count(db_path))
+
+    closer = threading.Thread(target=close_from_elsewhere)
+    closer.start()
+    closer.join()
+
+    assert observed.get_nowait() == 0
