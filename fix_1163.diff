diff --git a/integrations/hermes/tests/test_shutdown_closes_memory.py b/integrations/hermes/tests/test_shutdown_closes_memory.py
new file mode 100644
index 0000000..f88727c
--- /dev/null
+++ b/integrations/hermes/tests/test_shutdown_closes_memory.py
@@ -0,0 +1,173 @@
+"""The provider's shutdown() must actually close the memory it built (#1163).
+
+Both packaged shutdown paths already called ``self._memory.close()`` inside a
+``try/except Exception``; before core grew ``close()`` the AttributeError was
+swallowed and the thread-local SQLite handles stayed open for the process
+lifetime. Only a cold process shows the fd arithmetic, hence a fresh
+interpreter per case (modeled on test_thread_connection_release.py).
+
+Mode notes (both verified against the provider source):
+- ``profile_isolation: true`` (seeded into the handed Hermes home's
+  config.yaml) makes the provider build a ``Mnemosyne`` wrapper, and
+  shutdown() closes it through the ``self._memory.close()`` call site.
+- Without the flag the provider builds a bare ``BeamMemory`` and deliberately
+  does NOT close it on shutdown (``_release_thread_connection``'s contract:
+  "The provider's per-session beams are retained on purpose"), so the probe
+  itself exercises the newly-added ``BeamMemory.close()`` on the retained
+  beam. Either way the database descriptors reach zero only because core
+  implements ``close()`` — on the pre-PR tree the same probe dies on the
+  AttributeError that shutdown used to swallow.
+"""
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+_REPO_ROOT = Path(__file__).resolve().parents[3]
+
+_SHUTDOWN_PROBE = '''
+import gc
+import json
+import os
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1])
+profile_isolation = sys.argv[2] == "1"
+
+sys.path.insert(0, str(root / "integrations" / "hermes" / "src"))
+sys.path.insert(0, str(root))
+os.environ["MNEMOSYNE_DATA_DIR"] = str(root / "default")
+
+import mnemosyne_hermes as provider_module
+from mnemosyne.core.beam import BeamMemory  # noqa: F401  (cold-import parity with the release probe)
+
+# The provider resolves profile isolation from the Hermes config in the home
+# it is handed (read_hermes_config_key reads <hermes_home>/config.yaml); there
+# is no env override. Seed the file so the parametrization actually flips the
+# backing class between Mnemosyne and BeamMemory.
+home = root / "hermes-home"
+home.mkdir(parents=True, exist_ok=True)
+if profile_isolation:
+    (home / "config.yaml").write_text(
+        "memory:\\n  mnemosyne:\\n    profile_isolation: true\\n"
+    )
+
+
+def _fds_under(prefix_path):
+    prefix = str(prefix_path)
+    count = 0
+    for fd in Path("/proc/self/fd").iterdir():
+        try:
+            target = os.readlink(fd)
+        except OSError:
+            continue
+        if target.startswith(prefix):
+            count += 1
+    return count
+
+
+observed = {}
+
+provider = provider_module.MnemosyneMemoryProvider()
+provider.initialize(
+    "fd-session",
+    agent_context="primary",
+    hermes_home=str(home),
+    auto_sleep=False,
+)
+beam = provider._beam
+# ``_memory`` is only set for the profile-isolated Mnemosyne wrapper; a bare
+# BeamMemory lives in ``_beam``. Record the backing class either way — that is
+# the thing shutdown() (or, for the deliberately-retained beam, close())
+# releases, and what the parametrization flips.
+observed["memory_class"] = (
+    type(provider._memory).__name__
+    if provider._memory is not None
+    else type(beam).__name__
+    if beam is not None
+    else "None"
+)
+before = _fds_under(root)
+
+provider.shutdown()
+# Scope to the home the provider owns: importing mnemosyne.core.memory
+# (unavoidable in Mnemosyne mode) opens a default-database handle under
+# MNEMOSYNE_DATA_DIR at module load; it belongs to the import, not shutdown.
+after_shutdown = _fds_under(home)
+observed["after_shutdown"] = after_shutdown
+
+# Non-isolated mode: the provider retains per-session beams on purpose, so
+# shutdown does not (and must not) close this one. Close it here to prove the
+# capability shutdown relies on in the isolated mode now exists in core.
+if beam is not None:
+    beam.close()
+
+# The default-database handle that importing mnemosyne.core.memory opened at
+# module load is held only by the thread-local cache; drop it so the final
+# count reflects what close() released rather than an import side effect.
+gc.collect()
+observed["after"] = _fds_under(root)
+
+observed["before"] = before
+observed["memory_is_none"] = provider._memory is None
+observed["worker_ran"] = True
+observed["memory_imported"] = "mnemosyne.core.memory" in sys.modules
+
+assert observed["memory_class"] in ("Mnemosyne", "BeamMemory"), observed["memory_class"]
+assert before >= 1, before
+assert observed["after"] == 0, observed["after"]
+assert observed["memory_is_none"] is True
+print(json.dumps(observed))
+'''
+
+
+def _run_shutdown_probe(root: Path, profile_isolation: str) -> dict:
+    """Drive provider initialize()+shutdown() in a fresh interpreter."""
+    script = root / "shutdown_probe.py"
+    script.write_text(_SHUTDOWN_PROBE)
+    env = dict(os.environ)
+    env["MNEMOSYNE_NO_EMBEDDINGS"] = "1"
+    env["HERMES_HOME"] = str(root / "hermes-home")
+    completed = subprocess.run(
+        [sys.executable, str(script), str(root), profile_isolation],
+        cwd=str(_REPO_ROOT),
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=300,
+    )
+    assert completed.returncode == 0, completed.stderr
+    return json.loads(completed.stdout.strip().splitlines()[-1])
+
+
+@pytest.mark.parametrize("memory_mode", ["Mnemosyne", "BeamMemory"])
+def test_shutdown_closes_the_memory_it_built(tmp_path, memory_mode):
+    """shutdown() drops the database descriptors regardless of backing class.
+
+    ``Mnemosyne`` is forced by seeding ``profile_isolation: true`` in the
+    handed Hermes home (the provider reads it from that config.yaml), and
+    shutdown() itself must leave zero descriptors. ``BeamMemory`` is the
+    default when the flag is absent; the provider deliberately retains that
+    beam across shutdown, so the probe closes the retained beam with the new
+    ``close()`` — the exact call shutdown's ``self._memory.close()`` sites
+    used to swallow as an AttributeError before core implemented it (#1163).
+    """
+    profile_isolation = "1" if memory_mode == "Mnemosyne" else "0"
+    observed = _run_shutdown_probe(tmp_path, profile_isolation)
+
+    assert observed["worker_ran"] is True
+    assert observed["memory_class"] == memory_mode
+    assert observed["before"] >= 1
+    assert observed["after"] == 0
+    assert observed["memory_is_none"] is True
+    if memory_mode == "Mnemosyne":
+        # shutdown() closed the wrapper it built: nothing survives it.
+        assert observed["after_shutdown"] == 0
+    else:
+        # The retained beam survives shutdown by design; only close() frees it.
+        assert observed["after_shutdown"] >= 1
